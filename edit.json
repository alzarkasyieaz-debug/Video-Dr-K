  "clips": [
    { "id": "a", "in": 960.66, "out": 967.00, "head_y": 900,
      "zoom": { "type": "push", "from": 1.58, "to": 1.78, "pow": 1.2 },
      "text": "Tuan-tuan, kalau kita masih bermain politik persepsi, yang rugi siapa? Yang rugi rakyat." },
    { "id": "b", "in": 130.88, "out": 158.30,
      "zoom": { "type": "push", "from": 1.22, "to": 1.40 },
      "text": "Cuma menariknya kita pada kali ini adalah perpaduan antara dua parti terbesar umat Islam. Antara UMNO dan juga PAS. UMNO yang padanya keahlian Melayu-Islam 3.6 juta, berpadu dengan PAS yang orang Islam, Melayu-Islamnya 1 juta. Angkanya 4.6 juta." },
    { "id": "c", "in": 199.40, "out": 212.40,
      "zoom": { "type": "ease", "from": 1.32, "to": 1.52 },
      "text": "Perkara yang awal dibuat oleh Nabi SAW ialah membina masjid. Diikuti dengan menyatukan umat Islam di negeri Madinah Al-Munawarah." },
    { "id": "d", "in": 232.30, "out": 245.60,
      "zoom": { "type": "ease", "from": 1.56, "to": 1.30 },
      "text": "Kerana pertamanya, membina masjid lambang menegakkan agama. Membina persaudaraan pula, ini adalah asas untuk kekuatan mana-mana negara." },
    { "id": "e", "in": 481.96, "out": 492.35,
      "zoom": { "type": "push", "from": 1.34, "to": 1.70, "pow": 1.3, "punch": { "at": { "word": "tuntutan" }, "add": 0.08 } },
      "text": "Bukan hanya untuk menang pilihan raya. Tetapi kita padu kerana itu tuntutan Allah SWT, menyatukan dua kelompok yang bertelingkah panjang." },
    { "id": "f", "in": 1134.82, "out": 1145.08,
      "zoom": { "type": "ease", "from": 1.62, "to": 1.08 },
      "text": "Ini bukan perpaduan untuk politik semata-mata. Inilah perpaduan orang Islam demi agama Allah SWT untuk kita perkasakan Islam dengan negara kita secara bersama, insyaAllah." }
  ],

